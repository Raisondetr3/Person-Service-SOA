<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://itmo.ru/person-service"
        xmlns:tns="http://itmo.ru/person-service"
        elementFormDefault="qualified">

    <xs:simpleType name="ColorType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="GREEN"/>
            <xs:enumeration value="BLUE"/>
            <xs:enumeration value="ORANGE"/>
            <xs:enumeration value="BROWN"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CountryType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="FRANCE"/>
            <xs:enumeration value="SPAIN"/>
            <xs:enumeration value="INDIA"/>
            <xs:enumeration value="THAILAND"/>
            <xs:enumeration value="SOUTH_KOREA"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="Coordinates">
        <xs:sequence>
            <xs:element name="x" type="xs:long"/>
            <xs:element name="y" type="xs:long"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Location">
        <xs:sequence>
            <xs:element name="x" type="xs:int" minOccurs="0"/>
            <xs:element name="y" type="xs:double" minOccurs="0"/>
            <xs:element name="z" type="xs:double" minOccurs="0"/>
            <xs:element name="name" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PersonRequest">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="coordinates" type="tns:Coordinates"/>
            <xs:element name="creationDate" type="xs:dateTime" minOccurs="0"/>
            <xs:element name="height" type="xs:long" minOccurs="0"/>
            <xs:element name="weight" type="xs:float"/>
            <xs:element name="hairColor" type="tns:ColorType"/>
            <xs:element name="eyeColor" type="tns:ColorType"/>
            <xs:element name="nationality" type="tns:CountryType"/>
            <xs:element name="location" type="tns:Location" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PersonResponse">
        <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="coordinates" type="tns:Coordinates"/>
            <xs:element name="creationDate" type="xs:dateTime"/>
            <xs:element name="height" type="xs:long" minOccurs="0"/>
            <xs:element name="weight" type="xs:float"/>
            <xs:element name="hairColor" type="tns:ColorType"/>
            <xs:element name="eyeColor" type="tns:ColorType"/>
            <xs:element name="nationality" type="tns:CountryType"/>
            <xs:element name="location" type="tns:Location" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PageRequest">
        <xs:sequence>
            <xs:element name="page" type="xs:int" default="0"/>
            <xs:element name="size" type="xs:int" default="4"/>
            <xs:element name="sort" type="tns:Sort" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Sort">
        <xs:sequence>
            <xs:element name="property" type="xs:string"/>
            <xs:element name="direction" type="xs:string" default="ASC"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="FilterOperator">
        <xs:restriction base="xs:string">
            <xs:enumeration value="EQ"/>
            <xs:enumeration value="NE"/>
            <xs:enumeration value="GT"/>
            <xs:enumeration value="GTE"/>
            <xs:enumeration value="LT"/>
            <xs:enumeration value="LTE"/>
            <xs:enumeration value="LIKE"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="FilterCondition">
        <xs:sequence>
            <xs:element name="field" type="xs:string"/>
            <xs:element name="operator" type="tns:FilterOperator"/>
            <xs:element name="value" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SearchCriteria">
        <xs:sequence>
            <xs:element name="filters" type="tns:FilterCondition" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="pageRequest" type="tns:PageRequest" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PagedResponse">
        <xs:sequence>
            <xs:element name="content" type="tns:PersonResponse" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="totalElements" type="xs:long"/>
            <xs:element name="totalPages" type="xs:int"/>
            <xs:element name="currentPage" type="xs:int"/>
            <xs:element name="pageSize" type="xs:int"/>
            <xs:element name="hasNext" type="xs:boolean"/>
            <xs:element name="hasPrevious" type="xs:boolean"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MapEntry">
        <xs:sequence>
            <xs:element name="key" type="xs:string"/>
            <xs:element name="value" type="xs:long"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="StatsResponse">
        <xs:sequence>
            <xs:element name="entries" type="tns:MapEntry" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="getPersonByIdRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="getPersonByIdResponse" type="tns:PersonResponse"/>

    <xs:element name="createPersonRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="person" type="tns:PersonRequest"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="createPersonResponse" type="tns:PersonResponse"/>

    <xs:element name="updatePersonRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:int"/>
                <xs:element name="person" type="tns:PersonRequest"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="updatePersonResponse" type="tns:PersonResponse"/>

    <xs:element name="deletePersonRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="deletePersonResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="searchPersonsRequest" type="tns:SearchCriteria"/>
    <xs:element name="searchPersonsResponse" type="tns:PagedResponse"/>

    <xs:element name="countPersonsRequest">
        <xs:complexType/>
    </xs:element>
    <xs:element name="countPersonsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="count" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="personExistsRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="personExistsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="exists" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="findPersonWithLongestNameRequest">
        <xs:complexType/>
    </xs:element>
    <xs:element name="findPersonWithLongestNameResponse" type="tns:PersonResponse"/>

    <xs:element name="deleteOneByHairColorRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="hairColor" type="tns:ColorType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="deleteOneByHairColorResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="deleted" type="xs:boolean"/>
                <xs:element name="id" type="xs:int" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="findPersonsByNationalityLessThanRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nationality" type="tns:CountryType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="findPersonsByNationalityLessThanResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="persons" type="tns:PersonResponse" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getHairColorStatsRequest">
        <xs:complexType/>
    </xs:element>
    <xs:element name="getHairColorStatsResponse" type="tns:StatsResponse"/>

    <xs:element name="getNationalityStatsRequest">
        <xs:complexType/>
    </xs:element>
    <xs:element name="getNationalityStatsResponse" type="tns:StatsResponse"/>

</xs:schema>